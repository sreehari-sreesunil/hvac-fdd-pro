# Read by docker-compose.yml and interpolated into every service's
# environment via ${VAR} references - this is the file that matters
# for `docker compose up`, distinct from each service's own
# .env.example (which matters for running a service locally outside
# Docker via `poetry run`).

# Shared across all 6 services - JWT tokens issued by auth-service are
# verified by every other service using this same value, so it MUST be
# identical everywhere, which docker-compose's single-root-.env
# interpolation guarantees by construction (not something to keep in
# sync by hand). Falls back to a dev-only default if unset - fine for
# local development, must be a real, long random string before any
# real deployment.
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Shared secret for trusted internal service-to-service calls (e.g.
# ml-service's scheduler creating alerts via notification-service).
# Falls back to a committed dev-safe default if unset - acceptable for
# local dev only, since these services are already inside the trusted
# Docker network; must be a real, unique value before any real
# deployment.
INTERNAL_API_KEY=change-this-shared-secret-before-any-real-deployment

# Required - no safe default (see docker-compose.yml's
# ${GROQ_API_KEY:?...}, which refuses to start without it). Free, no
# billing account required - get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of origins allowed to make cross-origin browser
# requests against every service's API (e.g. the frontend's real
# domain in production). Was a wildcard ("*") until this project's
# input validation/security audit flagged it as a real gap before any
# real deployment. Defaults to the local frontend dev server - set
# this to your real deployed frontend's origin(s) before going live,
# e.g. CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000GROQ_API_KEY=your_groq_api_key_here
