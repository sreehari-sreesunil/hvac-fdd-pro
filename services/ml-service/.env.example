DATABASE_URL=postgresql://hvac:hvac_dev_password@localhost:5432/ml_service_db
JWT_SECRET_KEY=change-this-to-a-long-random-string
AUTH_SERVICE_URL=http://localhost:8000
ASSET_SERVICE_URL=http://localhost:8001
TELEMETRY_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8004

# Shared secret for trusted internal service-to-service calls (this
# service's alert scheduler creating alerts in notification-service) -
# must match notification-service's own INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=change-this-shared-secret-before-any-real-deployment

# Least-privilege ("viewer" role) account the baseline-deviation alert
# scheduler authenticates as - create this user via the normal signup
# flow, invite it into whichever org(s) it should monitor.
SCHEDULER_SERVICE_ACCOUNT_EMAIL=ml-scheduler-service@example.com
SCHEDULER_SERVICE_ACCOUNT_PASSWORD=change-this-to-a-real-password
