DATABASE_URL=postgresql://hvac:hvac_dev_password@localhost:5432/copilot_service_db
JWT_SECRET_KEY=change-this-to-a-long-random-string
ASSET_SERVICE_URL=http://localhost:8001
TELEMETRY_SERVICE_URL=http://localhost:8002
ML_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004

# Real key required - no safe default exists for this one (see
# docker-compose.yml's ${GROQ_API_KEY:?...}, which refuses to start
# without it). Free, no billing account required - get one at
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of allowed browser CORS origins - was a
# wildcard ("*") until this project's security audit flagged it.
CORS_ALLOWED_ORIGINS=http://localhost:3000
